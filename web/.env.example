# Build-time frontend config. Copy to .env (gitignored).
# Your Mini App's t.me link (BotFather → /newapp). Share links become
# <link>?startapp=h_<hawker-id>, which opens that hawker inside Telegram.
# Leave unset to share plain web links (https://<host>/?h=<hawker-id>).
VITE_TG_APP_LINK=https://t.me/HawkerGoWhereBot/app
